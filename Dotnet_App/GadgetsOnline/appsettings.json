{
  "appsettings": {
    "webpages:Enabled": "false",
    "ClientValidationEnabled": "true",
    "UnobtrusiveJavaScriptEnabled": "true"
  },
  // Connection strings are NOT stored here. The app defaults to a local SQLite
  // file when the `dbmode` environment variable is unset, which is what the
  // Graviton demo uses -- no external database required.
  //
  // To point at MySQL instead, set dbmode=env and supply the connection string
  // via the GadgetsOnlineEntities environment variable (see
  // Models/GadgetsOnlineEntities.cs OnConfiguring). Never commit credentials.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
