@model List<GadgetsOnline.Models.Product>
@{
    ViewBag.Title = "Welcome to Gadgets Online!";
}

<div id="promotion">

</div>

<h3><em>Our best selling </em>Gadgets Online.</h3>

@*
    Runs a personalisation pass over the catalogue. Styled with the storefront's
    existing .button class so it reads as an ordinary shop feature; the corner
    readout in _Layout reports the throughput it achieves.
*@
<p>
    <input type="button" id="find-gadget-button" class="button"
           value="Find My Perfect Gadget"
           onclick="return GadgetsPerf.start();" />
    <span style="margin-left: 8px; font-size: 11px; color: #8A8575;">
        Ranks the full catalogue against your browsing profile.
    </span>
</p>

<class ="row">




    <ul id="album-list">
        @foreach (var product in Model)
        {
            <li>
                <a href="@Url.Action("Details", "Store",
                                new { id = product.ProductId })">

                    <img alt="@product.Name" src="@product.ProductArtUrl" />
                    <span>@product.Name</span>
                </a>
            </li>
        }
    </ul>

