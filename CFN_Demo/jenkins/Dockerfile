# Jenkins for the Graviton demo.
#
# The stock jenkins/jenkins image has no docker client, no AWS CLI and no
# pipeline plugins, so every pipeline step would fail. This adds exactly what the
# two demo pipelines call and nothing else.
#
# Deliberately NOT the Jenkins_Config/JenkinsCasC.yaml topology: that models a
# production controller with an ALB, EFS and a plugin catalogue. The demo needs
# two pipelines that visibly build and deploy.
FROM jenkins/jenkins:lts-jdk17

USER root

# docker CLI only -- no engine. The host's docker socket is bind-mounted in, so
# builds run on the host's buildx with its amd64 binfmt handler already
# registered, and no docker-in-docker is involved.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg jq python3 unzip \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg \
      | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
 && chmod a+r /etc/apt/keyrings/docker.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
      > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli docker-buildx-plugin \
 && rm -rf /var/lib/apt/lists/*

# AWS CLI v2, for ECR authentication and Systems Manager deploys. The container
# reaches instance metadata through the docker bridge, so it picks up the build
# host's instance role with no credentials on disk.
RUN ARCH="$(uname -m)" \
 && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" -o /tmp/awscli.zip \
 && unzip -q /tmp/awscli.zip -d /tmp \
 && /tmp/aws/install \
 && rm -rf /tmp/awscli.zip /tmp/aws

# Only the plugins the two pipelines need. Pinning nothing on purpose: a demo
# wants whatever is current, and a stale pin fails the image build later.
RUN jenkins-plugin-cli --plugins \
      workflow-aggregator \
      pipeline-stage-view \
      pipeline-utility-steps \
      htmlpublisher \
      timestamper \
      ansicolor

USER jenkins

# Skip the setup wizard and the "you have no security realm" nag. Acceptable
# because the only route to this Jenkins is the load balancer, whose security
# group admits one CIDR.
#
# DirectoryBrowserSupport.CSP is emptied so a published HTML report renders with
# its own styling. Jenkins otherwise serves workspace files under
# "sandbox allow-scripts; default-src 'none'", which silently strips inline CSS
# and leaves the report looking like unformatted text. Emptying it is safe here
# for the same reason as above: the only content served is generated by this
# repository's own pipeline, and the only route in is the restricted load
# balancer.
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false \
-Dhudson.model.DownloadService.noSignatureCheck=true \
-Dhudson.model.DirectoryBrowserSupport.CSP="
ENV JENKINS_SLAVE_AGENT_PORT=50000
